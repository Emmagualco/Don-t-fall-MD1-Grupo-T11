      value: 
      objectReference: {fileID: 595531684}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: dialoguePanel
      value: 
      objectReference: {fileID: 1834026171}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: burrowMovement
      value: 
      objectReference: {fileID: 1481338998}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: playerController
      value: 
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: dialogueLines.Array.size
      value: 9
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: 'dialogueLines.Array.data[3]'
      value: "Burrow: \xBFQuer\xE9s llegar m\xE1s alto? \xA1Tengo un truco para vos!...."
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: 'dialogueLines.Array.data[4]'
      value: "Burrow: Salt\xE1 contra una pared y, mientras est\xE9s en el aire,
        presion\xE1 ESPACIO otra vez para impulsarte desde ella...."
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: 'dialogueLines.Array.data[5]'
      value: "Burrow: \xA1Domin\xE1 el salto de pared y vas a poder alcanzar lugares
        que parec\xEDan imposibles!"
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: 'dialogueLines.Array.data[6]'
      value: "Burrow: \xA1\xDAltimo truco! Presion\xE1 ESPACIO para saltar...."
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: 'dialogueLines.Array.data[7]'
      value: "Burrow: \xA1Pero ojo! \xA1Esta plataforma te dar\xE1 un impulso extra
        fuerte para llegar mucho m\xE1s alto!...."
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: 'dialogueLines.Array.data[8]'
      value: "Burrow: \xA1Eso es todo lo que puedo ense\xF1arte por ahora! \xA1Mucha
        suerte en tu aventura, y nos vemos m\xE1s adelante!"
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
      propertyPath: OnBlockCompleted.m_PersistentCalls.m_Calls.Array.size
      value: 1
      objectReference: {fileID: 0}
    - target: {fileID: 4554906684363363993, guid: c73ae6621f8832748a78dfb8aec6dd12, type: 3}
